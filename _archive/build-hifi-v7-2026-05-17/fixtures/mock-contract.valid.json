{
  "sharedEnums": {
    "agency": ["fda", "ema"],
    "submissionStatus": ["in_progress", "filed", "on_hold"],
    "indexStatus": ["pending", "indexed", "failed", "not_uploaded"],
    "impactItemStatus": ["proposed", "confirmed", "assigned", "under_review", "assessed", "decided", "dismissed", "escalated"],
    "confidenceLevel": ["high", "medium", "low"]
  },
  "entities": [
    {
      "name": "users",
      "tsInterfaceName": "User",
      "idConvention": "u-{n}",
      "variantCounts": { "happy": 5, "empty": 0, "error": 0 },
      "fields": [
        { "name": "id", "kind": "id" },
        { "name": "name", "kind": "string", "constraint": "Full name" },
        { "name": "email", "kind": "string" },
        { "name": "role", "kind": "literalUnion", "literalValues": ["ra_director", "section_owner", "vp"] },
        { "name": "initials", "kind": "string", "constraint": "1-3 chars" },
        { "name": "title", "kind": "string" }
      ]
    },
    {
      "name": "submissions",
      "tsInterfaceName": "Submission",
      "idConvention": "sub-{slug}",
      "variantCounts": { "happy": 4, "empty": 0, "error": 1 },
      "fields": [
        { "name": "id", "kind": "id" },
        { "name": "name", "kind": "string" },
        { "name": "indication", "kind": "string" },
        { "name": "therapeuticArea", "kind": "string" },
        { "name": "agency", "kind": "enum", "enumName": "agency" },
        { "name": "filingDeadline", "kind": "isoDate" },
        { "name": "status", "kind": "enum", "enumName": "submissionStatus" },
        { "name": "openConflictCount", "kind": "number" },
        { "name": "createdAt", "kind": "isoDate" },
        { "name": "createdBy", "kind": "id", "referencesEntity": "users" }
      ],
      "relationships": [
        { "field": "createdBy", "references": "users", "cardinality": "many_to_one" }
      ],
      "notes": "Use real oncology / respiratory indications. No marketing voice."
    },
    {
      "name": "guidanceEvents",
      "tsInterfaceName": "GuidanceEvent",
      "idConvention": "ge-{n}",
      "variantCounts": { "happy": 5, "empty": 0, "error": 1 },
      "fields": [
        { "name": "id", "kind": "id" },
        { "name": "title", "kind": "string", "constraint": "≤ 80 chars" },
        { "name": "agency", "kind": "enum", "enumName": "agency" },
        { "name": "publishedAt", "kind": "isoDate" },
        { "name": "ingestedAt", "kind": "isoDate" },
        { "name": "ingestionConfidence", "kind": "enum", "enumName": "confidenceLevel" },
        { "name": "pageCount", "kind": "number" },
        { "name": "changedExcerptCount", "kind": "number" }
      ]
    }
  ]
}
